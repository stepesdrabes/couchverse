# copy to .env and adjust
DB_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Where media + app data live.
#  - leave unset: Docker-managed named volume (works out of the box)
#  - set to a path (e.g. /mnt/usbdisk/couchverse): bind-mount a real disk
#    folder you can also reach over SMB/SFTP. Then set PUID/PGID below to
#    that folder's owner (run `id -u` and `id -g`) or you'll get
#    permission-denied on uploads/transcodes.
#MEDIA_ROOT=/mnt/usbdisk/couchverse
#PUID=1000
#PGID=1000
