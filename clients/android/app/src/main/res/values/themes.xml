<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="canvas">#FF07080D</color>
    <color name="launcher_background">#FFE50914</color>

    <!-- the canvas colour from the first frame, so launching never flashes white -->
    <style name="Theme.Couchverse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
    </style>
</resources>
