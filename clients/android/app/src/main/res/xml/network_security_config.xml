<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-hosted servers may be reached over plain http (D14; the app marks them as not encrypted)
  and often sit behind a certificate the user installed for their home network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
