// Settings shared by every target. Per-builder values (signing team, bundle id root) belong in
// Local.xcconfig, copied from Local.xcconfig.template; it is gitignored and optional.

BUNDLE_ID_ROOT = io.stepes.couchverse
DEVELOPMENT_TEAM =
// Widgets, Top Shelf and other extras that need capabilities a free personal team may lack
// (plan 10.9); off until a builder turns them on. Exactly YES turns them on: the settings below
// pick their value by it.
EXTENSIONS_ENABLED = NO
// With them the apps and their extensions share an App Group, claimed in their entitlements and
// named in their Info.plist, and the extensions are signed and embedded; without them none of
// this exists, so a free personal team signs the apps as before.
COUCHVERSE_APP_GROUP_YES = group.$(BUNDLE_ID_ROOT)
COUCHVERSE_APP_GROUP = $(COUCHVERSE_APP_GROUP_$(EXTENSIONS_ENABLED))
COUCHVERSE_ENTITLEMENTS_YES = Config/Couchverse.entitlements
COUCHVERSE_SIGN_EXTENSIONS_YES = YES

CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 27.0
TVOS_DEPLOYMENT_TARGET = 27.0

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = NO

ONLY_ACTIVE_ARCH[config=Debug] = YES
ENABLE_TESTABILITY[config=Debug] = YES
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG $(inherited)
GCC_OPTIMIZATION_LEVEL[config=Debug] = 0
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -O
SWIFT_COMPILATION_MODE[config=Release] = wholemodule
DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym
VALIDATE_PRODUCT[config=Release] = YES

#include? "Local.xcconfig"
