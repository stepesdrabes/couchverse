// The Apple TV app.

SDKROOT = appletvos
SUPPORTED_PLATFORMS = appletvos appletvsimulator
TARGETED_DEVICE_FAMILY = 3

PRODUCT_NAME = Couchverse TV
PRODUCT_MODULE_NAME = CouchverseTV
// one bundle id for both apps, so they share an App ID (a free team gets few per week)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_ROOT)

INFOPLIST_FILE = Config/CouchverseTV-Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Couchverse
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.entertainment
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIUserInterfaceStyle = Dark

// the Top Shelf extension is always built but embedded, like the App Group, only with
// EXTENSIONS_ENABLED (Base.xcconfig)
CODE_SIGN_ENTITLEMENTS = $(COUCHVERSE_ENTITLEMENTS_$(EXTENSIONS_ENABLED))
EXCLUDED_SOURCE_FILE_NAMES = CouchverseTopShelf.appex
INCLUDED_SOURCE_FILE_NAMES = $(COUCHVERSE_EMBEDDED_$(EXTENSIONS_ENABLED))
COUCHVERSE_EMBEDDED_YES = CouchverseTopShelf.appex

ASSETCATALOG_COMPILER_APPICON_NAME = App Icon & Top Shelf Image
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_PREVIEWS = YES
