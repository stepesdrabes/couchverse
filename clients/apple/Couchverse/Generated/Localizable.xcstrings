    "intent_continue_watching_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehraje první titul z Pokračovat ve sledování, nebo ten, který vyberete, od místa, kde jste skončili."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the first title in Continue Watching, or the one you choose, from where you stopped."
          }
        }
      }
    },
