                      "value": "%arg členů"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg member"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg members"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
