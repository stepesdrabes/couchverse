{
	"$comment": "Couchverse design tokens, the single source for every client. `cargo xtask codegen` turns them into CSS/TypeScript (web), Swift (Apple) and Kotlin (Android). Colours are #rrggbb or #rrggbbaa; lengths are points/dp/px; durations are milliseconds.",
	"color": {
		"bg": "#07080d",
		"surface": "#11131c",
		"surface-2": "#191c27",
		"edge": "#262a38",
		"text": "#f2f4f8",
		"muted": "#8e93a6",
		"faint": "#5b6072",
		"accent": "#e50914",
		"accent-strong": "#b80710",
		"accent-soft": "#3a1216",
		"on-accent": "#ffffff",
		"success": "#34d399",
		"danger": "#f0635c",
		"glow-violet": "#8b7cf0",
		"glow-teal": "#3dd6c4"
	},
	"accent": {
		"$comment": "How every client derives the accent palette from one artwork or site accent (the core implements it).",
		"strongShade": -0.22,
		"softAlpha": 0.16,
		"onAccentLight": "#ffffff",
		"onAccentDark": "#0b0c10",
		"luminanceThreshold": 0.42
	},
	"tier": {
		"rookie": { "color": "#7c8496", "glow": "#7c849659" },
		"remote": { "color": "#60a5fa", "glow": "#60a5fa59" },
		"snack": { "color": "#22d3ee", "glow": "#22d3ee59" },
		"binger": { "color": "#34d399", "glow": "#34d39959" },
		"popcorn": { "color": "#a3e635", "glow": "#a3e63559" },
		"marathoner": { "color": "#facc15", "glow": "#facc1561" },
		"sage": { "color": "#fb923c", "glow": "#fb923c61" },
		"cinephile": { "color": "#f87171", "glow": "#f8717161" },
		"master": { "color": "#c084fc", "glow": "#c084fc66" },
		"legend": { "color": "#e879f9", "glow": "#e879f96b" }
	},
	"medal": {
		"bronze": { "from": "#d08b4e", "to": "#8a4f22", "ring": "#e0a066", "glow": "#d08b4e66" },
		"silver": { "from": "#d7dfee", "to": "#8e97ab", "ring": "#e4ebf7", "glow": "#d7dfee59" },
		"gold": { "from": "#f7cf63", "to": "#c1861a", "ring": "#ffdd80", "glow": "#f7cf6373" },
		"platinum": { "from": "#a8f0e4", "to": "#7fb3ff", "ring": "#c9f4ff", "glow": "#a8f0e473" }
	},
	"radius": {
		"card": 14,
		"input": 10,
		"pill": 999
	},
	"spacing": {
		"xxs": 2,
		"xs": 4,
		"sm": 8,
		"md": 12,
		"lg": 16,
		"xl": 24,
		"xxl": 32,
		"xxxl": 48
	},
	"type": {
		"$comment": "Roles, not sizes: each maps to the platform's scalable text style (Dynamic Type on Apple, the Material type scale on Android) plus a weight and tracking.",
		"hero": { "apple": "largeTitle", "material": "displaySmall", "weight": 800, "tracking": -0.02 },
		"title": { "apple": "title", "material": "headlineMedium", "weight": 700, "tracking": -0.01 },
		"section": { "apple": "title3", "material": "titleLarge", "weight": 700, "tracking": 0 },
		"card": { "apple": "headline", "material": "titleSmall", "weight": 600, "tracking": 0 },
		"body": { "apple": "body", "material": "bodyLarge", "weight": 400, "tracking": 0 },
		"caption": { "apple": "caption", "material": "bodySmall", "weight": 500, "tracking": 0 },
		"eyebrow": { "apple": "caption2", "material": "labelSmall", "weight": 600, "tracking": 0.3 }
	},
	"motion": {
		"$comment": "Springs are response (seconds) + damping fraction; curves are cubic-bezier control points.",
		"spring": {
			"snappy": { "response": 0.3, "damping": 0.86 },
			"smooth": { "response": 0.45, "damping": 0.9 },
			"bouncy": { "response": 0.5, "damping": 0.68 }
		},
		"curve": {
			"standard": { "duration": 150, "bezier": [0.25, 0.1, 0.25, 1] },
			"enter": { "duration": 250, "bezier": [0.16, 1, 0.3, 1] }
		},
		"heroInterval": 8000
	}
}
